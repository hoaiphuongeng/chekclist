rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /records/{recordId} {
      allow read, write: if isValidId(recordId);
    }

    match /templates/{templateId} {
      allow read, write: if isValidId(templateId);
    }

    match /employees/{employeeId} {
      allow read, write: if isValidId(employeeId);
    }

    match /schedules/{scheduleId} {
      allow read, write: if isValidId(scheduleId);
    }

    match /supplementalRequests/{requestId} {
      allow read, write: if isValidId(requestId);
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
